# ============================================================
# METHAGU KALANJIYAM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this template to .env.local for local development.
# NEVER commit real credentials, secrets, or .env.local to git.
# ============================================================

# ------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & AUTH (SSR)
# ------------------------------------------------------------
# Project URL (Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Client Anon Key (safe for public bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SERVER-SIDE ONLY: Service role key bypasses RLS for atomic server mutations.
# NEVER prefix with NEXT_PUBLIC_ or expose to client bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY (INR)
# ------------------------------------------------------------
# Client publishable Key ID (rzp_test_... or rzp_live_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Server-side API Key ID (used for order creation)
RAZORPAY_KEY_ID=rzp_test_your_key_id
# Server-side API Key Secret (used for basic auth on Razorpay API)
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
# Server-side Webhook Secret for HMAC SHA-256 signature verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------
# 3. RESEND EMAIL SERVICE & TWO-STEP AUTH (SERVER-SIDE ONLY)
# ------------------------------------------------------------
# Resend API Key (re_...) for Admin 2FA OTP & User Email Verification
RESEND_API_KEY=re_your_resend_api_key
# Sender address (use onboarding@resend.dev for test mode or verified domain for production)
RESEND_FROM_EMAIL="Methagu Kalanjiyam <onboarding@resend.dev>"
# Cryptographic secret for signing admin session tokens & pre-auth state (min 32 bytes)
AUTH_SECRET=generate_with_openssl_rand_hex_32

# ------------------------------------------------------------
# 4. STORE & NOTIFICATIONS
# ------------------------------------------------------------
# Canonical production site URL
NEXT_PUBLIC_SITE_URL=https://methagukalanjiyam.in
# Store WhatsApp Contact / Support Number (country code + phone)
NEXT_PUBLIC_WHATSAPP_NUMBER=916384654946
# Default storefront locale
NEXT_PUBLIC_DEFAULT_LOCALE=ta

# Admin 2FA toggle: set to 'false' to bypass OTP (dev/staging only). MUST be 'true' in production.
ADMIN_2FA_ENABLED=true

# ------------------------------------------------------------
# 5. ERPNEXT / FRAPPE INTEGRATION
# ------------------------------------------------------------
ERP_URL=https://erp.methagukalanjiyam.in
ERP_API_KEY=251d72274f50663
ERP_API_SECRET=3a8290d0264db86
ERP_ENABLED=true
ERP_AUTO_SYNC_ORDERS=true
ERP_COMPANY="Methagu Kalanjiyam"
ERP_DEFAULT_ITEM_GROUP="Books"
